<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
</head>
<body>
<title>João Victor Barbosa Dev</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="Portfólio de João Victor Barbosa, desenvolvedor FullStack em formação, de Sete Lagoas, MG.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#070605; --card:rgba(255,255,255,.035); --card-hover:rgba(255,255,255,.065);
  --text:#f6f2ee; --text-soft:#a9a29b; --text-dark:#7d766f;
  --primary:#ff7a1a; --primary-light:#ff9347; --pr:255,122,26; --on-primary:#1a0d02;
  --border:rgba(255,255,255,.09); --solid:#0e0c0a; --line:rgba(255,255,255,.025);
  --c-kw:#ff9347; --c-str:#74d99b; --c-arr:#7bbcff; --track:rgba(255,255,255,.08);
  --radius:20px; --header-height:76px; --shadow:0 20px 70px rgba(0,0,0,.45);
  --font-head:'Space Grotesk','Segoe UI',sans-serif; --font-body:'Inter','Segoe UI',sans-serif; --font-mono:'JetBrains Mono',ui-monospace,monospace;
  color-scheme: dark;
}
@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) {
    --bg:#f6f3ef; --card:rgba(0,0,0,.035); --card-hover:rgba(0,0,0,.065);
    --text:#16120e; --text-soft:#5e564f; --text-dark:#7b726a;
    --primary:#c2410c; --primary-light:#ea580c; --pr:194,65,12; --on-primary:#ffffff;
    --border:rgba(0,0,0,.1); --solid:#ffffff; --line:rgba(0,0,0,.04);
    --c-kw:#c2410c; --c-str:#15803d; --c-arr:#1d4ed8; --track:rgba(0,0,0,.09);
    --shadow:0 20px 60px rgba(60,30,10,.12); color-scheme: light;
  }
}
:root[data-theme="light"] {
  --bg:#f6f3ef; --card:rgba(0,0,0,.035); --card-hover:rgba(0,0,0,.065);
  --text:#16120e; --text-soft:#5e564f; --text-dark:#7b726a;
  --primary:#c2410c; --primary-light:#ea580c; --pr:194,65,12; --on-primary:#ffffff;
  --border:rgba(0,0,0,.1); --solid:#ffffff; --line:rgba(0,0,0,.04);
  --c-kw:#c2410c; --c-str:#15803d; --c-arr:#1d4ed8; --track:rgba(0,0,0,.09);
  --shadow:0 20px 60px rgba(60,30,10,.12); color-scheme: light;
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; scroll-padding-top:calc(var(--header-height) + 16px); }
body {
  min-width:320px; font-family:var(--font-body); background:var(--bg); color:var(--text);
  overflow-x:clip; line-height:1.6;
  padding-left:max(16px, env(safe-area-inset-left, 0px));
  padding-right:max(16px, env(safe-area-inset-right, 0px));
  transition:background .35s,color .35s;
}
body::before { content:""; position:fixed; inset:0 0 auto; height:env(safe-area-inset-top, 0px); background:var(--bg); z-index:1100; }
svg.i { width:1em; height:1em; flex-shrink:0; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
svg.i.fill { fill:currentColor; stroke:none; }
a { color:inherit; text-decoration:none; }
button,input,textarea { font:inherit; }
button { border:0; cursor:pointer; }
::selection { background:var(--primary); color:var(--on-primary); }
:focus-visible { outline:2px solid var(--primary); outline-offset:3px; border-radius:6px; }

/* fundo */
.background { position:fixed; inset:0; z-index:-1; overflow:hidden; pointer-events:none; }
.grid { position:absolute; inset:0; background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px); background-size:60px 60px; mask-image:linear-gradient(to bottom,#000,rgba(0,0,0,.5) 55%,transparent); -webkit-mask-image:linear-gradient(to bottom,#000,rgba(0,0,0,.5) 55%,transparent); }
.tech-lines { position:absolute; inset:0; opacity:.3; }
.tech-lines::before,.tech-lines::after { content:""; position:absolute; width:1px; height:100%; background:linear-gradient(to bottom,transparent,rgba(var(--pr),.2),transparent); }
.tech-lines::before { left:18%; } .tech-lines::after { right:18%; }
.glow { position:absolute; width:min(520px,80vw); height:min(520px,80vw); border-radius:50%; filter:blur(100px); opacity:.12; }
.glow-1 { top:-300px; right:-180px; background:var(--primary); }
.glow-2 { bottom:-300px; left:-180px; background:var(--primary-light); opacity:.07; }
.scanline { position:absolute; left:0; width:100%; height:1px; background:rgba(var(--pr),.18); box-shadow:0 0 15px rgba(var(--pr),.18); animation:scan 9s linear infinite; }
@keyframes scan { from { top:-5%; } to { top:105%; } }
.particle { position:absolute; bottom:0; width:2px; height:2px; border-radius:50%; background:var(--primary); box-shadow:0 0 8px var(--primary); animation:particleFloat linear infinite; }
@keyframes particleFloat { 0% { transform:translateY(0); opacity:0; } 15%,85% { opacity:.55; } 100% { transform:translateY(-110vh) translateX(30px); opacity:0; } }

/* header */
.header { position:fixed; top:env(safe-area-inset-top, 0px); left:0; width:100%; height:var(--header-height); display:flex; align-items:center; justify-content:space-between; gap:20px; z-index:1000; border-bottom:1px solid transparent; transition:background .3s,border-color .3s;
  padding-left:max(16px, env(safe-area-inset-left, 0px), 5%, calc((100% - 1240px)/2));
  padding-right:max(16px, env(safe-area-inset-right, 0px), 5%, calc((100% - 1240px)/2)); }
.header.scrolled { background:color-mix(in srgb,var(--bg) 88%,transparent); border-color:var(--border); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); }
.logo,.footer-logo { font-family:var(--font-head); font-weight:800; letter-spacing:-1px; }
.logo { font-size:22px; flex-shrink:0; }
.logo span,.footer-logo span { color:var(--primary); }
.nav { display:flex; align-items:center; gap:clamp(12px,2vw,30px); }
.nav-link { position:relative; color:var(--text-soft); font-size:13px; font-weight:500; transition:color .25s; white-space:nowrap; }
.nav-link:hover,.nav-link.active { color:var(--primary); }
.nav-link::after { content:""; position:absolute; left:0; bottom:-8px; width:0; height:2px; background:var(--primary); box-shadow:0 0 8px var(--primary); transition:width .25s; }
.nav-link:hover::after,.nav-link.active::after { width:100%; }
.header-actions { display:flex; align-items:center; gap:10px; flex-shrink:0; }
.theme-btn,.menu-btn { width:42px; height:42px; display:grid; place-items:center; border:1px solid var(--border); border-radius:50%; background:var(--card); color:var(--text); font-size:17px; transition:.25s; }
.theme-btn:hover { color:var(--primary); border-color:var(--primary); transform:rotate(15deg); }
.menu-btn { display:none; border-radius:10px; padding:11px; align-content:center; gap:4px; }
.menu-btn span { display:block; width:100%; height:2px; background:var(--text); transition:transform .25s,opacity .25s; }

/* seções */
main { width:100%; }
.section { position:relative; width:min(1180px,100%); margin-inline:auto; padding:104px 0; min-width:0; }
.hero { min-height:100svh; display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr); align-items:center; gap:clamp(28px,5vw,60px); padding-top:calc(var(--header-height) + 45px); padding-bottom:90px; }
.section-header { max-width:760px; margin-bottom:52px; }
.section-header.center { text-align:center; margin-inline:auto; }
.section-tag { display:inline-flex; align-items:center; gap:8px; color:var(--primary); font-size:11px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:16px; }
.section-header h2 { font-family:var(--font-head); font-size:clamp(32px,5vw,56px); line-height:1.08; letter-spacing:-1.8px; overflow-wrap:anywhere; text-wrap:balance; }
.section-header h2 span,.contact-content h2 span { color:var(--primary); }
.section-header p { margin-top:16px; color:var(--text-soft); font-size:15px; line-height:1.7; }

/* hero */
.hero-content { position:relative; z-index:2; min-width:0; }
.hero-badge { display:inline-flex; align-items:center; gap:9px; max-width:100%; padding:8px 14px; border:1px solid rgba(var(--pr),.3); border-radius:50px; background:rgba(var(--pr),.07); color:var(--text-soft); font:500 10.5px var(--font-mono); letter-spacing:.8px; margin-bottom:24px; }
.hero-badge span { width:7px; height:7px; flex:0 0 7px; border-radius:50%; background:var(--primary); box-shadow:0 0 12px var(--primary); animation:pulse 1.5s infinite; }
@keyframes pulse { 50% { opacity:.3; transform:scale(.65); } }
.hero-small { color:var(--text-soft); font-size:15px; margin-bottom:5px; }
.hero-title { font-family:var(--font-head); font-size:clamp(46px,7.2vw,96px); line-height:.98; letter-spacing:-3.5px; overflow-wrap:anywhere; }
.hero-title span { display:block; color:var(--primary); text-shadow:0 0 38px rgba(var(--pr),.25); }
.typing-container { margin-top:22px; font-family:var(--font-head); font-size:clamp(17px,2vw,21px); font-weight:600; line-height:1.5; min-height:1.5em; }
.typing,.cursor { color:var(--primary); }
.cursor { animation:blink .8s infinite; }
@keyframes blink { 50% { opacity:0; } }
.hero-description { max-width:560px; margin-top:18px; color:var(--text-soft); line-height:1.8; font-size:15px; }
.hero-buttons { display:flex; gap:12px; margin-top:30px; flex-wrap:wrap; }
.btn { display:inline-flex; align-items:center; justify-content:center; gap:10px; min-height:48px; padding:13px 22px; border-radius:8px; font-size:13px; font-weight:800; text-align:center; transition:transform .25s,box-shadow .25s,background .25s,border-color .25s,color .25s; }
.btn:hover { transform:translateY(-3px); }
.btn-primary { color:var(--on-primary); background:var(--primary); box-shadow:0 10px 30px rgba(var(--pr),.22); }
.btn-primary:hover { background:var(--primary-light); box-shadow:0 12px 36px rgba(var(--pr),.32); }
.btn-outline { border:1px solid var(--border); background:var(--card); color:var(--text); }
.btn-outline:hover { border-color:var(--primary); color:var(--primary); }
.hero-social { display:flex; gap:10px; margin-top:30px; }
.hero-social a { width:42px; height:42px; display:grid; place-items:center; border:1px solid var(--border); border-radius:9px; color:var(--text-soft); font-size:18px; transition:.25s; }
.hero-social a:hover { color:var(--primary); border-color:var(--primary); transform:translateY(-3px); }
.hero > * { animation:rise .8s cubic-bezier(.2,.7,.2,1) both; }
.hero > .hero-visual { animation-delay:.12s; }
@keyframes rise { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:none; } }

.hero-visual { position:relative; overflow:clip; min-width:0; min-height:510px; display:grid; place-items:center; isolation:isolate; }
.visual-grid { position:absolute; width:min(500px,100%); aspect-ratio:1; background-image:linear-gradient(rgba(var(--pr),.09) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--pr),.09) 1px,transparent 1px); background-size:25px 25px; mask-image:radial-gradient(circle,#000,transparent 70%); -webkit-mask-image:radial-gradient(circle,#000,transparent 70%); transform:perspective(500px) rotateX(60deg) rotateZ(-8deg); opacity:.55; }
.code-card { position:relative; z-index:3; width:min(430px,100%); min-width:0; border:1px solid var(--border); border-radius:10px; background:var(--solid); box-shadow:var(--shadow),0 0 45px rgba(var(--pr),.08); overflow:hidden; animation:cardFloat 6s ease-in-out infinite; }
.code-card::before { content:""; position:absolute; top:0; left:-100%; width:70%; height:1px; background:var(--primary); box-shadow:0 0 15px var(--primary); animation:codeScan 5s linear infinite; }
@keyframes codeScan { to { left:130%; } }
@keyframes cardFloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-8px); } }
.code-top { display:flex; align-items:center; gap:12px; padding:14px 16px; border-bottom:1px solid var(--border); color:var(--text-dark); font:11px var(--font-mono); }
.code-top small { margin-left:auto; color:var(--primary); font-size:9px; letter-spacing:1px; }
.code-dots { display:flex; gap:6px; flex-shrink:0; }
.code-dots span { width:9px; height:9px; border-radius:50%; background:var(--track); }
.code-dots span:first-child { background:var(--primary); box-shadow:0 0 8px rgba(var(--pr),.6); }
.code-content { padding:24px clamp(12px,2vw,24px); font-family:var(--font-mono); font-size:clamp(11px,1.05vw,13px); line-height:2; color:var(--text-soft); overflow-x:auto; }
.code-content p { white-space:nowrap; }
.kw { color:var(--c-kw); } .br { color:var(--primary); } .str { color:var(--c-str); } .arr { color:var(--c-arr); }
.code-comment { margin-top:14px; color:var(--text-dark); }
.indent { padding-left:clamp(12px,2vw,24px); }
.code-footer { display:flex; justify-content:space-between; gap:10px; padding:10px 16px; border-top:1px solid var(--border); color:var(--text-dark); font:9px var(--font-mono); letter-spacing:.5px; }
.code-footer i { display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--primary); margin-right:6px; vertical-align:middle; }
.visual-ring { position:absolute; border-radius:50%; border:1px solid rgba(var(--pr),.16); pointer-events:none; }
.ring-1 { width:min(470px,95%); aspect-ratio:1; animation:spin 24s linear infinite; }
.ring-2 { width:min(560px,100%); aspect-ratio:1; border-style:dashed; border-color:rgba(var(--pr),.1); animation:spinReverse 38s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } } @keyframes spinReverse { to { transform:rotate(-360deg); } }
.target { position:absolute; border:1px solid rgba(var(--pr),.45); border-radius:50%; pointer-events:none; }
.target::before,.target::after { content:""; position:absolute; background:var(--primary); }
.target::before { width:30px; height:1px; top:50%; left:-15px; }
.target::after { width:1px; height:30px; left:50%; top:-15px; }
.target-1 { width:14px; height:14px; right:8%; top:17%; animation:pulse 2.5s infinite; }
.target-2 { width:9px; height:9px; left:4%; bottom:18%; animation:pulse 2.8s infinite; }
.floating-card { position:absolute; z-index:4; display:flex; align-items:center; gap:9px; max-width:45%; padding:10px 14px; border:1px solid var(--border); border-radius:8px; background:var(--solid); font-size:11px; font-weight:800; box-shadow:var(--shadow); }
.floating-card b { color:var(--primary); font:700 11px var(--font-mono); }
.card-html { top:15%; left:0; animation:float1 4s ease-in-out infinite; }
.card-js { right:0; top:32%; animation:float2 5s ease-in-out infinite; }
.card-java { left:5%; bottom:15%; animation:float3 4.5s ease-in-out infinite; }
@keyframes float1 { 50% { transform:translateY(-8px) rotate(-2deg); } }
@keyframes float2 { 50% { transform:translateY(9px) rotate(2deg); } }
@keyframes float3 { 50% { transform:translateY(-7px) rotate(-2deg); } }
.system-status { position:absolute; right:4%; bottom:5%; display:flex; align-items:center; gap:7px; color:var(--text-dark); font:9px var(--font-mono); letter-spacing:1px; }
.system-status span { width:6px; height:6px; border-radius:50%; background:var(--primary); box-shadow:0 0 10px var(--primary); }
.scroll-down { position:absolute; bottom:24px; left:50%; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:8px; color:var(--text-dark); font:9px var(--font-mono); letter-spacing:2px; animation:none; }
.scroll-down svg { color:var(--primary); animation:scrollArrow 1.5s infinite; }
@keyframes scrollArrow { 50% { transform:translateY(5px); } }

/* sobre */
.about-grid { display:grid; grid-template-columns:minmax(0,900px); justify-content:start; }
.about-content { color:var(--text-soft); line-height:1.8; min-width:0; }
.about-content p { margin-bottom:16px; font-size:15px; }
.about-content .about-highlight { font-family:var(--font-head); font-size:clamp(20px,2.5vw,25px); line-height:1.4; color:var(--text); }
.about-info { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:26px; }
.about-info div { min-width:0; padding:15px; border:1px solid var(--border); border-radius:9px; background:var(--card); transition:border-color .25s,transform .25s; }
.about-info div:hover { border-color:rgba(var(--pr),.45); transform:translateY(-3px); }
.about-info span { display:block; color:var(--text-dark); font:10px var(--font-mono); text-transform:uppercase; letter-spacing:.8px; margin-bottom:5px; }
.about-info strong { font-size:13px; color:var(--text); overflow-wrap:anywhere; }
.subjects { margin-top:24px; }
.subjects h3 { font:700 11px var(--font-mono); letter-spacing:1.5px; text-transform:uppercase; color:var(--text-dark); margin-bottom:12px; }
.tags { display:flex; flex-wrap:wrap; gap:8px; list-style:none; }
.tags li { padding:7px 12px; border:1px solid rgba(var(--pr),.22); background:rgba(var(--pr),.07); color:var(--primary); font-size:12px; font-weight:600; border-radius:6px; }

/* skills */
.skills { width:min(1300px,100%); }
.skills-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
.skill-card { position:relative; min-width:0; padding:26px; border:1px solid var(--border); border-radius:10px; background:var(--card); overflow:hidden; transition:transform .3s,border-color .3s,background .3s; }
.skill-card::before { content:""; position:absolute; top:0; left:0; width:0; height:2px; background:var(--primary); box-shadow:0 0 15px var(--primary); transition:width .35s; }
.skill-card:hover::before { width:100%; }
.skill-card:hover { transform:translateY(-5px); background:var(--card-hover); border-color:rgba(var(--pr),.35); }
.skill-icon { width:50px; height:50px; display:grid; place-items:center; border-radius:10px; background:rgba(var(--pr),.1); color:var(--primary); font:700 12px var(--font-mono); margin-bottom:18px; letter-spacing:.3px; }
.skill-card h3 { font-family:var(--font-head); font-size:21px; margin-bottom:10px; }
.skill-card p { min-height:52px; color:var(--text-soft); font-size:13px; line-height:1.7; }
.skill-level { display:flex; justify-content:space-between; gap:10px; margin-top:18px; font-size:11px; color:var(--text-dark); }
.skill-level strong { color:var(--primary); font-family:var(--font-mono); font-size:13px; font-variant-numeric:tabular-nums; }
.progress { height:4px; margin-top:8px; background:var(--track); border-radius:4px; overflow:hidden; }
.progress span { display:block; width:var(--progress); height:100%; background:linear-gradient(90deg,var(--primary),var(--primary-light)); box-shadow:0 0 10px rgba(var(--pr),.5); border-radius:4px; transform-origin:left; transition:transform 1.1s cubic-bezier(.2,.7,.2,1); }
.js .progress span { transform:scaleX(0); }
.js .progress.go span { transform:scaleX(1); }
.note { margin-top:22px; text-align:center; color:var(--text-dark); font-size:12px; }

/* trajetória */
.timeline { position:relative; width:min(820px,100%); margin:auto; }
.timeline::before { content:""; position:absolute; left:20px; top:0; bottom:0; width:1px; background:linear-gradient(var(--primary),transparent); }
.timeline-item { position:relative; padding-left:76px; padding-bottom:32px; min-width:0; }
.timeline-item:last-child { padding-bottom:0; }
.timeline-dot { position:absolute; left:0; top:0; width:41px; height:41px; display:grid; place-items:center; border-radius:50%; background:var(--bg); border:1px solid var(--primary); color:var(--primary); font-size:17px; box-shadow:0 0 20px rgba(var(--pr),.15); z-index:2; }
.timeline-content { min-width:0; padding:22px; border:1px solid var(--border); border-radius:10px; background:var(--card); transition:border-color .25s,transform .25s,background .25s; }
.timeline-content:hover { border-color:rgba(var(--pr),.4); transform:translateX(4px); background:var(--card-hover); }
.timeline-date { color:var(--primary); font:700 11px var(--font-mono); text-transform:uppercase; letter-spacing:1px; }
.timeline-content h3 { margin-top:8px; font-family:var(--font-head); font-size:clamp(18px,2.5vw,21px); overflow-wrap:anywhere; }
.timeline-content h4 { margin-top:5px; color:var(--text-dark); font:500 12px/1.6 var(--font-mono); overflow-wrap:anywhere; }
.timeline-content p { margin-top:12px; color:var(--text-soft); font-size:13px; line-height:1.7; }

/* cursos */
.courses-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
.course-card { min-width:0; display:flex; flex-direction:column; overflow:hidden; border:1px solid var(--border); border-radius:10px; background:var(--card); transition:transform .3s,border-color .3s; }
.course-card:hover { transform:translateY(-4px); border-color:rgba(var(--pr),.4); }
.course-banner { position:relative; height:112px; display:grid; place-items:center; overflow:hidden; background:linear-gradient(135deg,rgba(var(--pr),.16),rgba(var(--pr),.03)); }
.course-banner::after { content:""; position:absolute; width:200%; height:1px; background:var(--primary); opacity:.3; animation:projectLine 6s linear infinite; }
@keyframes projectLine { from { transform:translateX(-40%) rotate(-25deg); } to { transform:translateX(40%) rotate(-25deg); } }
.course-banner b { position:relative; z-index:2; font:800 34px var(--font-head); color:var(--primary); letter-spacing:-1px; text-shadow:0 0 28px rgba(var(--pr),.4); }
.course-banner span { position:absolute; top:12px; right:12px; z-index:3; padding:5px 9px; border:1px solid var(--border); border-radius:5px; background:var(--solid); color:var(--text); font:700 11px var(--font-mono); font-variant-numeric:tabular-nums; }
.course-body { flex:1; display:flex; flex-direction:column; gap:6px; padding:20px; }
