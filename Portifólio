<script>
(function () {
  "use strict";
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var root = document.documentElement;
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  root.classList.add("js");

  // tema
  var themeIcon = $("#themeIcon");
  function isLight() {
    var t = root.getAttribute("data-theme");
    if (t) return t === "light";
    return window.matchMedia("(prefers-color-scheme: light)").matches;
  }
  function paintIcon() {
    themeIcon.innerHTML = '<use href="#' + (isLight() ? "i-sun" : "i-moon") + '"/>';
    $("#themeBtn").setAttribute("aria-label", isLight() ? "Ativar tema escuro" : "Ativar tema claro");
  }
  try { var saved = localStorage.getItem("jv-theme"); if (saved) root.setAttribute("data-theme", saved); } catch (e) {}
  paintIcon();
  $("#themeBtn").addEventListener("click", function () {
    var next = isLight() ? "dark" : "light";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("jv-theme", next); } catch (e) {}
    paintIcon();
  });

  // menu mobile
  var menuBtn = $("#menuBtn"), nav = $("#nav");
  function closeMenu() { menuBtn.classList.remove("open"); nav.classList.remove("open"); menuBtn.setAttribute("aria-expanded", "false"); menuBtn.setAttribute("aria-label", "Abrir menu"); }
  menuBtn.addEventListener("click", function () {
    var open = !nav.classList.contains("open");
    nav.classList.toggle("open", open); menuBtn.classList.toggle("open", open);
    menuBtn.setAttribute("aria-expanded", String(open)); menuBtn.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
  });
  $$(".nav-link").forEach(function (l) { l.addEventListener("click", closeMenu); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeMenu(); });
  document.addEventListener("click", function (e) { if (nav.classList.contains("open") && !nav.contains(e.target) && !menuBtn.contains(e.target)) closeMenu(); });
  window.addEventListener("resize", function () { if (window.innerWidth > 860) closeMenu(); }, { passive: true });

  // header e voltar ao topo
  var header = $("#header"), backTop = $("#backTop"), queued = false;
  function onScroll() {
    if (queued) return; queued = true;
    requestAnimationFrame(function () {
      header.classList.toggle("scrolled", window.scrollY > 30);
      backTop.classList.toggle("show", window.scrollY > 500);
      queued = false;
    });
  }
  window.addEventListener("scroll", onScroll, { passive: true }); onScroll();
  backTop.addEventListener("click", function () { window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" }); });

  // texto digitado
  var typingEl = $("#typing");
  var words = ["desenvolvedor FullStack em formação.", "estudante de informática.", "focado em Java e POO.", "de Sete Lagoas, MG."];
  if (!reduced) {
    var wi = 0, ci = words[0].length, del = true;
    var tick = function () {
      var w = words[wi];
      ci += del ? -1 : 1;
      typingEl.textContent = w.slice(0, ci);
      var d = del ? 38 : 75;
      if (!del && ci >= w.length) { del = true; d = 1600; }
      else if (del && ci <= 0) { del = false; wi = (wi + 1) % words.length; d = 300; }
      setTimeout(tick, d);
    };
    setTimeout(tick, 2200);
  }

  // barras de conhecimento
  var bars = $$(".progress");
  function go(b) { b.classList.add("go"); }
  if ("IntersectionObserver" in window && !reduced) {
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { go(e.target); io.unobserve(e.target); } }); }, { threshold: 0.4 });
    bars.forEach(function (b) { io.observe(b); });
    setTimeout(function () { bars.forEach(go); }, 6000);
  } else bars.forEach(go);

  // link ativo
  var links = $$(".nav-link"), secs = $$("main section[id]");
  if ("IntersectionObserver" in window) {
    var so = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        links.forEach(function (l) { l.classList.toggle("active", l.getAttribute("href") === "#" + e.target.id); });
      });
    }, { rootMargin: "-35% 0px -55% 0px" });
    secs.forEach(function (s) { so.observe(s); });
  }

  // partículas
  var pc = $("#particles");
  if (pc && !reduced) {
    var n = window.innerWidth < 480 ? 7 : window.innerWidth < 800 ? 12 : 22, frag = document.createDocumentFragment();
    for (var i = 0; i < n; i++) {
      var p = document.createElement("span"); p.className = "particle";
      p.style.left = (Math.random() * 100) + "%";
      p.style.animationDuration = (12 + Math.random() * 12) + "s";
      p.style.animationDelay = (Math.random() * -18) + "s";
      frag.appendChild(p);
    }
    pc.appendChild(frag);
  }

  // certificados
  var d = $("#lb"), li = $("#lb-i"), lt = $("#lb-t");
  $$("button.act").forEach(function (b) {
    b.addEventListener("click", function () {
      li.src = b.dataset.img; li.alt = b.dataset.title; lt.textContent = b.dataset.title;
      if (d.showModal) d.showModal(); else d.setAttribute("open", "");
    });
  });
  $("#lb-x").addEventListener("click", function () { d.close(); });
  d.addEventListener("click", function (e) { if (e.target === d) d.close(); });

  // copiar e-mail
  $("#copy").addEventListener("click", function () {
    var btn = this, txt = $("#mail");
    function done() { btn.textContent = "Copiado"; setTimeout(function () { btn.textContent = "Copiar"; }, 1800); }
    function fb() { var r = document.createRange(); r.selectNodeContents(txt); var s = getSelection(); s.removeAllRanges(); s.addRange(r); btn.textContent = "Selecionado"; }
    try { navigator.clipboard.writeText(txt.textContent).then(done, fb); } catch (e) { fb(); }
  });
})();
</script>

